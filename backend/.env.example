# Copy to .env and fill in real values. Never commit the real .env.
PORT=8000
# Long random value, 32+ characters (required in production).
SESSION_SECRET=change-me-to-a-long-random-value

# Frontend address(es) allowed to call the API with the sign-in cookie, comma-separated.
CORS_ORIGIN=http://localhost:5173
# lax = same site or local development; none = frontend and API on different HTTPS domains.
COOKIE_SAMESITE=lax

# First Owner account — created once, when there are no users yet.
# Leave ADMIN_PASSWORD empty to have a random password generated and printed once in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=accounting
DB_USER=accounting_app
DB_PASSWORD=change-me
